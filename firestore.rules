rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /consultations/{consultationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'message', 'source', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 30 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 1 &&
        request.resource.data.message.size() <= 1500 &&
        request.resource.data.source == 'jeongseong-landing' &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
